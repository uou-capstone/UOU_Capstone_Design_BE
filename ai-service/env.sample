# --- AI Service (env.sample) ---
# Copy this file to `.env` and fill in your real secrets.

# Google Gemini API key used by all AI agents.
GEMINI_API_KEY=your_gemini_api_key

# Gemini Files API PDF fileRef upload/cache limit for QA.
# Default: 50MB
GEMINI_FILE_REF_MAX_BYTES=52428800

# Spring Boot server base URL for webhook callbacks (optional).
SPRING_BOOT_BASE_URL=http://127.0.0.1:8080

# Shared secret for inbound Spring Boot -> FastAPI bridge requests.
# Spring must send the same value as the X-AI-SECRET-KEY header.
# APP_ENV=prod or ENV=production requires a non-placeholder AI_SECRET_KEY.
APP_ENV=local
AI_SECRET_KEY=change_me

# Browser CORS origins for local development. Server-to-server Spring calls do not need CORS.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false

# Exam Studio PDF context limits. pdfPath must resolve inside uploads/.
EXAM_STUDIO_CONTEXT_TTL_SECONDS=21600
EXAM_STUDIO_PDF_CONTEXT_MAX_BYTES=52428800
EXAM_STUDIO_PDF_TEXT_MAX_CHARS=500000

# Redis configuration (optional, defaults shown)
# For local development: localhost:6379
# For Docker: redis:6379 (service name from docker-compose)
REDIS_HOST=localhost
REDIS_PORT=6379
